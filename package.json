{
  "name": "flexer",
  "version": "2.0.0",
  "description": "FLEXER Luxury Eyewear Full-Stack Ecommerce Platform",
  "main": "server/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/server.js",
    "build": "npm run design:build && node tools/build_static.js",
    "dev": "node --watch server/server.js",
    "pretest": "npm run design:build",
    "test": "node --test tests/ecommerce.test.js",
    "design:dev": "vite --config vite.config.mjs",
    "design:build": "vite build --config vite.config.mjs",
    "lint": "eslint frontend/src",
    "format:check": "prettier --check \"frontend/**/*.{css,html,js}\" \"docs/**/*.md\" \"database/**/*.json\"",
    "format": "prettier --write \"frontend/**/*.{css,html,js}\" \"docs/**/*.md\" \"database/**/*.json\""
  },
  "keywords": [
    "flexer",
    "eyewear",
    "sunglasses",
    "ecommerce",
    "sri-lanka",
    "luxury"
  ],
  "author": "FLEXER Eyewear",
  "license": "ISC",
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@netlify/functions": "^6.1.1",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
