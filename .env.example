# ============================================================
# FLEXER EYEWEAR — Environment Configuration Template
# Do not commit production secrets to version control.
# ============================================================

# Application
PORT=3000
NODE_ENV=production
DOMAIN=https://flexer.mrteches.com

# Security & Sessions
JWT_SECRET=replace-with-a-cryptographically-secure-random-string-in-production
DEFAULT_ADMIN_PASSWORD=replace-with-a-strong-private-admin-password
CORS_ORIGIN=https://flexer.mrteches.com

# Official WhatsApp Configuration
WHATSAPP_NUMBER=94775580968
WHATSAPP_COMMUNITY_URL=PASTE_OFFICIAL_WHATSAPP_COMMUNITY_URL_HERE

# Bank Transfer Settings (Configure in Admin or Env)
BANK_ACCOUNT_HOLDER=TO_BE_CONFIRMED
BANK_NAME=TO_BE_CONFIRMED
BANK_BRANCH=TO_BE_CONFIRMED
BANK_ACCOUNT_NUMBER=TO_BE_CONFIRMED

# Koko Payment Gateway (To be supplied once merchant approval is finalized)
KOKO_ENABLED=0
KOKO_MODE=manual_request # Set to 'direct_api' once merchant API credentials are live
KOKO_MERCHANT_ID=PENDING_MERCHANT_CREDENTIALS
KOKO_API_KEY=
KOKO_WEBHOOK_SECRET=
